{
  "name": "aragon-backend",
  "description": "OpenSource backend services",
  "version": "0.4.1",
  "main": "index.ts",
  "license": "AGPL-3.0",
  "author": "Aragon Development Team",
  "scripts": {
    "start": "yarn run service:aragon-api",
    "service:aragon-api": "ts-node -r tsconfig-paths/register runners/aragon-api.ts",
    "service:aragon-indexer": "ts-node -r tsconfig-paths/register runners/aragon-indexer.ts",
    "service:aragon-rates": "ts-node -r tsconfig-paths/register runners/aragon-rates.ts",
    "service:aragon-dao": "ts-node -r tsconfig-paths/register runners/aragon-dao.ts",
    "service:aragon-plugins": "ts-node -r tsconfig-paths/register runners/aragon-plugins.ts",
    "service:aragon-admin-api": "ts-node -r tsconfig-paths/register runners/aragon-admin-api.ts",
    "tool": "ts-node -r tsconfig-paths/register tools/toolLauncher.ts",
    "push:check": "yarn lint:fix && yarn format:fix && yarn test:dotonly",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format:check": "prettier --check \"src/**/*.{ts,json}\" \"test/**/*.{ts,json}\" \"postman/**/*.json\" \"*.json\"",
    "format:fix": "prettier --write \"src/**/*.{ts,json}\" \"test/**/*.{ts,json}\" \"postman/**/*.json\" \"*.json\"",
    "test:dotonly": "dot-only-hunter test",
    "test:manual": "ts-node -r tsconfig-paths/register test/test.config.ts --manual",
    "test:unit": "ts-node -r tsconfig-paths/register test/test.config.ts --unit",
    "test:unit-dep": "ts-node -r tsconfig-paths/register test/test.config.ts --unit-dep",
    "test:unit:coverage": "rm -rf coverage .nyc_output && nyc --debug --no-clean --temp-dir=.nyc_output/ yarn test:unit",
    "test:coverage:check": "nyc check-coverage --temp-dir=.nyc_output/ --statements 97 --branches 82 --functions 97.50 --lines 97",
    "docker:test:unit-dep": "docker-compose up -d --build unit-dep",
    "docker:unit-dep-dependencies": "docker-compose up -d --build mongo1 mongo2 mongo3 mongo-init-replica rabbitmq",
    "docker:mongo": "docker-compose up -d --build mongo1 mongo2 mongo3 mongo-init-replica",
    "docker:rabbitmq": "docker rm -f aragon-rabbit || true && docker run -d --hostname aragon-rabbit --name aragon-rabbit -p 5672:5672 -p 15672:15672 rabbitmq:3-management",
    "docker:services": "docker-compose up --build -d service-aragon-api service-aragon-indexer service-aragon-rates service-aragon-admin-api",
    "wait:rabbitmq": "bash test/lib/scripts/waitUp.sh rabbitmq 5672",
    "wait:db": "bash test/lib/scripts/waitUp.sh mongo1 27017 && bash test/lib/scripts/waitUp.sh mongo2 27017 && bash test/lib/scripts/waitUp.sh mongo3 27017",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aragon/app-backend.git"
  },
  "bugs": {
    "url": "https://github.com/aragon/app-backend/issues"
  },
  "nyc": {
    "all": true,
    "extension": [
      ".ts"
    ],
    "include": [
      "src/**"
    ],
    "exclude": [
      "src/artifacts/**"
    ],
    "reporter": [
      "text",
      "lcov",
      "html",
      "json",
      "text-summary"
    ]
  },
  "dependencies": {
    "@ethersproject/constants": "^5.7.0",
    "@koa/router": "^12.0.1",
    "@pinata/sdk": "^2.1.0",
    "@sentry/node": "^7.102.1",
    "@typegoose/typegoose": "^12.1.0",
    "alchemy-sdk": "^3.4.2",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.8",
    "async": "^3.2.5",
    "axios": "^1.8.3",
    "bignumber.js": "^9.1.2",
    "bottleneck": "^2.19.5",
    "class-validator": "^0.14.1",
    "dayjs": "^1.11.10",
    "dayjs-plugin-utc": "^0.1.2",
    "dot-only-hunter": "^1.0.3",
    "dotenv": "^16.4.5",
    "ethers": "^6.11.1",
    "joi": "^17.12.2",
    "jsonwebtoken": "^9.0.2",
    "koa": "^2.16.1",
    "koa-bodyparser": "^4.4.1",
    "koa-jwt": "^4.0.4",
    "lodash": "^4.17.21",
    "logzio-nodejs": "^2.1.7",
    "mongoose": "^8.2.1",
    "speakeasy": "^2.0.0",
    "toobusy-js": "^0.5.1",
    "ts-node": "^10.9.2",
    "ts-retry-promise": "^0.8.0",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-replace-paths": "^0.0.14",
    "typescript": "^5.8.3",
    "ua-parser-js": "^2.0.3",
    "uuid": "^11.1.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.1",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@types/amqplib": "^0.10.5",
    "@types/async": "^3.2.24",
    "@types/chai": "^4.3.6",
    "@types/chai-as-promised": "^7.1.8",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/koa": "^2.15.0",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa__router": "^12.0.4",
    "@types/lodash": "^4.14.202",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.20",
    "@types/proxyquire": "^1.3.31",
    "@types/sinon": "^17.0.3",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^6.0.1",
    "@types/toobusy-js": "^0.5.4",
    "@types/ua-parser-js": "^0.7.39",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "chai": "^4.3.8",
    "chai-as-promised": "^7.1.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-promise": "^6.1.1",
    "husky": "^9.1.7",
    "mocha": "^10.3.0",
    "mongodb-memory-server": "^10.1.4",
    "nyc": "^17.1.0",
    "prettier": "^3.2.5",
    "proxyquire": "^2.1.3",
    "semantic-release": "^24.2.3",
    "sinon": "^20.0.0",
    "supertest": "^6.0.1",
    "ts-mocha": "^10.0.0",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.8"
  }
}
