{
  "name": "aragon-backend",
  "description": "OpenSource backend services",
  "version": "0.7.0",
  "main": "index.ts",
  "license": "AGPL-3.0",
  "author": "Aragon Development Team",
  "scripts": {
    "start": "yarn run service:aragon-api",
    "service:aragon-gateway": "ts-node -r tsconfig-paths/register runners/aragon-gateway.ts",
    "service:aragon-api": "ts-node -r tsconfig-paths/register runners/aragon-api.ts",
    "service:aragon-admin-api": "ts-node -r tsconfig-paths/register runners/aragon-admin-api.ts",
    "service:aragon-indexer": "ts-node -r tsconfig-paths/register runners/aragon-indexer.ts",
    "service:aragon-transfers": "ts-node -r tsconfig-paths/register runners/aragon-transfers.ts",
    "service:aragon-dao": "ts-node -r tsconfig-paths/register runners/aragon-dao.ts",
    "service:aragon-plugins": "ts-node -r tsconfig-paths/register runners/aragon-plugins.ts",
    "service:aragon-rates": "ts-node -r tsconfig-paths/register runners/aragon-rates.ts",
    "service:aragon-requeue": "ts-node -r tsconfig-paths/register runners/aragon-requeue.ts",
    "deploy:sand": "bash scripts/app-deploy.sh sand",
    "deploy:dev": "bash scripts/app-deploy.sh dev",
    "deploy:stg": "bash scripts/app-deploy.sh stg",
    "deploy:prod": "bash scripts/app-deploy.sh prod",
    "stop:sand": "bash scripts/app-deploy.sh stop sand",
    "stop:dev": "bash scripts/app-deploy.sh stop dev",
    "stop:stg": "bash scripts/app-deploy.sh stop stg",
    "stop:prod": "bash scripts/app-deploy.sh stop prod",
    "tool": "ts-node -r tsconfig-paths/register tools/toolLauncher.ts",
    "mig:create": "ts-node -r tsconfig-paths/register scripts/create-migration.ts",
    "mig:run": "ts-node -r tsconfig-paths/register runners/migration.ts",
    "mig:status": "ts-node -r tsconfig-paths/register scripts/migration-status.ts",
    "push:check": "yarn check:fix && yarn test:dotonly",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format:check": "biome format .",
    "format:fix": "biome format --write .",
    "check:fix": "biome check --write .",
    "test:dotonly": "dot-only-hunter test",
    "test:manual": "ts-node -r tsconfig-paths/register test/test.config.ts --manual",
    "test:unit": "ts-node -r tsconfig-paths/register test/test.config.ts --unit",
    "test:unit-dep": "ts-node -r tsconfig-paths/register test/test.config.ts --unit-dep",
    "test:unit:coverage": "rm -rf coverage .nyc_output && nyc --debug --no-clean --temp-dir=.nyc_output/ yarn test:unit",
    "test:coverage:check": "nyc check-coverage --temp-dir=.nyc_output/ --statements 98 --branches 90 --functions 97.97 --lines 98",
    "docker:test:unit-dep": "docker-compose up -d --build unit-dep",
    "docker:unit-dep-dependencies": "docker-compose up -d --build mongo1 mongo2 mongo3 mongo-init-replica rabbitmq",
    "docker:mongo": "docker-compose up -d --build mongo1 mongo2 mongo3 mongo-init-replica",
    "docker:rabbitmq": "docker rm -f aragon-rabbit || true && docker run -d --hostname aragon-rabbit --name aragon-rabbit -p 5672:5672 -p 15672:15672 rabbitmq:3-management",
    "docker:services": "docker-compose up --build -d service-aragon-api service-aragon-indexer service-aragon-rates service-aragon-admin-api",
    "wait:rabbitmq": "bash scripts/waitUp.sh rabbitmq 5672",
    "wait:db": "bash scripts/waitUp.sh mongo1 27017 && bash scripts/waitUp.sh mongo2 27017 && bash scripts/waitUp.sh mongo3 27017",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aragon/app-backend.git"
  },
  "bugs": {
    "url": "https://github.com/aragon/app-backend/issues"
  },
  "nyc": {
    "all": true,
    "extension": [".ts"],
    "include": ["src/**"],
    "exclude": ["scripts/**", "src/aragonContracts/**", "src/artifacts/**", "src/migrations/**"],
    "reporter": ["text", "lcov", "html", "json", "text-summary"]
  },
  "dependencies": {
    "@ethersproject/constants": "^5.7.0",
    "@koa/multer": "^4.0.0",
    "@koa/router": "^12.0.1",
    "@pinata/sdk": "^2.1.0",
    "@sentry/node": "^10.32.1",
    "@typegoose/typegoose": "^12.20.0",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.9",
    "async": "^3.2.5",
    "axios": "^1.13.2",
    "bignumber.js": "^9.3.1",
    "bottleneck": "^2.19.5",
    "class-validator": "^0.14.3",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.19",
    "dayjs-plugin-utc": "^0.1.2",
    "dot-only-hunter": "^1.0.3",
    "dotenv": "^16.5.0",
    "ethers": "^6.16.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "koa": "^3.0.3",
    "koa-bodyparser": "^4.4.1",
    "koa-jwt": "^4.0.4",
    "lodash": "^4.17.21",
    "logzio-nodejs": "^2.5.0",
    "merkletreejs": "^0.6.0",
    "mongoose": "^8.19.2",
    "multer": "^2.0.2",
    "prom-client": "^15.1.3",
    "speakeasy": "^2.0.0",
    "toobusy-js": "^0.5.1",
    "ts-node": "^10.9.2",
    "ts-retry-promise": "^0.8.0",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-replace-paths": "^0.0.14",
    "typescript": "^5.9.3",
    "ua-parser-js": "^2.0.7",
    "uuid": "^11.1.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/amqplib": "^0.10.8",
    "@types/async": "^3.2.25",
    "@types/chai": "^4.3.6",
    "@types/chai-as-promised": "^7.1.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/koa": "^3.0.1",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/koa__router": "^12.0.4",
    "@types/lodash": "^4.17.21",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.7.2",
    "@types/proxyquire": "^1.3.31",
    "@types/sinon": "^17.0.3",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^6.0.3",
    "@types/toobusy-js": "^0.5.4",
    "@types/ua-parser-js": "^0.7.39",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "chai": "^4.3.8",
    "chai-as-promised": "^7.1.1",
    "husky": "^9.1.7",
    "mocha": "^11.7.5",
    "mongodb-memory-server": "^10.3.0",
    "nyc": "^17.1.0",
    "proxyquire": "^2.1.3",
    "semantic-release": "^24.2.9",
    "sinon": "^20.0.0",
    "supertest": "^7.1.4",
    "ts-mocha": "^10.0.0",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16"
  }
}
