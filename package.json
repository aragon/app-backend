{
  "name": "aragon-backend",
  "description": "OpenSource backend services",
  "version": "1.0.0",
  "main": "index.ts",
  "license": "AGPL-3.0",
  "author": "Aragon Development Team",
  "scripts": {
    "start": "yarn run service:main",
    "service:main": "ts-node -r tsconfig-paths/register runners/main.ts",
    "service:api": "ts-node -r tsconfig-paths/register runners/api.ts",
    "service:indexer": "ts-node -r tsconfig-paths/register runners/indexer.ts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test:dotonly": "dot-only-hunter test",
    "test:manual": "ts-node -r tsconfig-paths/register test/test.config.ts --manual",
    "test:unit": "ts-node -r tsconfig-paths/register test/test.config.ts --unit",
    "test:unit:coverage": "rm -rf coverage .nyc_output && nyc --debug --no-clean --temp-dir=.nyc_output/ yarn test:unit",
    "test:coverage:check": "nyc check-coverage --temp-dir=.nyc_output/ --statements 97 --branches 83 --functions 96 --lines 97",
    "docker:dependencies": "docker-compose up -d --build mongo1 mongo2 mongo3 mongo-init-replica",
    "docker:services": "docker-compose up --build -d service-api service-data-sync",
    "wait:db": "bash test/lib/scripts/waitUp.sh mongo1 27017 && bash test/lib/scripts/waitUp.sh mongo2 27017 && bash test/lib/scripts/waitUp.sh mongo3 27017"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aragon/app-backend.git"
  },
  "bugs": {
    "url": "https://github.com/aragon/app-backend/issues"
  },
  "nyc": {
    "all": true,
    "extension": [
      ".ts"
    ],
    "include": [
      "src/**"
    ],
    "reporter": [
      "text",
      "lcov",
      "html",
      "json",
      "text-summary"
    ]
  },
  "dependencies": {
    "@ethersproject/constants": "^5.7.0",
    "@koa/router": "^12.0.1",
    "@pinata/sdk": "^2.1.0",
    "@sentry/node": "^7.102.1",
    "@typegoose/typegoose": "^12.1.0",
    "async": "^3.2.5",
    "axios": "^1.6.7",
    "class-validator": "^0.14.1",
    "dayjs": "^1.11.10",
    "dayjs-plugin-utc": "^0.1.2",
    "dot-only-hunter": "^1.0.3",
    "dotenv": "^16.4.5",
    "ethers": "^6.11.1",
    "graphql": "^16.8.1",
    "graphql-request": "^6.1.0",
    "graphql-scalars": "^1.22.5",
    "joi": "^17.12.2",
    "koa": "^2.15.0",
    "koa-bodyparser": "^4.4.1",
    "lodash": "^4.17.21",
    "logzio-nodejs": "^2.1.7",
    "mongoose": "^8.2.1",
    "toobusy-js": "^0.5.1",
    "ts-node": "^10.9.2",
    "ts-retry-promise": "^0.8.0",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-replace-paths": "^0.0.14",
    "typescript": "^5.3.3",
    "ua-parser-js": "^1.0.37",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/async": "^3.2.24",
    "@types/chai": "^4.3.6",
    "@types/chai-as-promised": "^7.1.8",
    "@types/koa": "^2.15.0",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa__router": "^12.0.4",
    "@types/lodash": "^4.14.202",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.20",
    "@types/proxyquire": "^1.3.31",
    "@types/sinon": "^17.0.3",
    "@types/supertest": "^6.0.1",
    "@types/toobusy-js": "^0.5.4",
    "@types/ua-parser-js": "^0.7.39",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "chai": "^4.3.8",
    "chai-as-promised": "^7.1.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-promise": "^6.1.1",
    "mocha": "^10.3.0",
    "mongodb-memory-server": "^9.1.6",
    "nyc": "^15.1.0",
    "prettier": "^3.2.5",
    "proxyquire": "^2.1.3",
    "sinon": "^17.0.1",
    "supertest": "^6.0.1",
    "ts-mocha": "^10.0.0",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.8"
  }
}
