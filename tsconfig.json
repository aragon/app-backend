{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "typeRoots": ["./node_modules/@types"],
    "outDir": "./dist",
    "rootDir": "./",
    "baseUrl": "./",
    "paths": {
      "@package": ["./package.json"],
      "@src/*": ["./src/*"],
      "@config": ["./config/index"],
      "@types": ["./src/types/index"],
      "@artifacts/*": ["./src/artifacts/*"],
      "@helpers/*": ["./src/helpers/*"],
      "@dbModels": ["./src/models/index"],
      "@logger": ["./src/logger/index"],
      "@errors": ["./src/helpers/errors"],
      "@runners/*": ["./runners/*"],
      "@governance/*": ["./src/governance/*"],
      "@middlewares/*": ["./src/middlewares/*"],
      "@models/*": ["./src/models/*"],
      "@modules/*": ["./src/modules/*"],
      "@services/*": ["./src/services/*"],
      "@state/*": ["./src/state/*"],
      "@api/*": ["./src/services/aragon-api/*"],
      "@indexer/*": ["./src/services/aragon-indexer/*"],
      "@rates/*": ["./src/services/aragon-rates/*"],
      "@admin-api/*": ["./src/services/aragon-admin-api/*"],
      "@tools/*": ["./tools/*"],
      "@test/*": ["./test/*"],
      "@aragonContracts/*": ["./src/services/aragonContracts/*"],
      "@handlers/*": ["./src/handlers/*"],
      "@plugins/*": ["./src/services/aragon-plugins/*"],
      "@transfers": ["./src/modules/transfers/index"]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["./**/*"],
  "exclude": ["node_modules", "types"]
}
